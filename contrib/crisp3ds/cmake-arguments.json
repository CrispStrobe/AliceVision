[
  "-S",
  "{source}",
  "-B",
  "{build}",
  "-G",
  "Ninja",
  "-DCMAKE_BUILD_TYPE=Release",
  "-DCMAKE_OSX_ARCHITECTURES=arm64",
  "-DCMAKE_INSTALL_PREFIX={install}",
  "-DCMAKE_INSTALL_LIBDIR=lib",
  "-DCMAKE_PREFIX_PATH={adaptivecpp};{dependencies};{eigen};{ceres};{homebrew};{homebrew}/opt/assimp@5",
  "-DCeres_DIR={ceres}/lib/cmake/Ceres",
  "-DEigen3_DIR={eigen}/share/eigen3/cmake",
  "-DBUILD_APPLE_FRAMEWORKS=OFF",
  "-DALICEVISION_BUILD_DEPENDENCIES=OFF",
  "-DALICEVISION_BUILD_SFM=ON",
  "-DALICEVISION_BUILD_MVS=ON",
  "-DALICEVISION_BUILD_HDR=OFF",
  "-DALICEVISION_BUILD_SEGMENTATION=OFF",
  "-DALICEVISION_BUILD_PHOTOMETRICSTEREO=OFF",
  "-DALICEVISION_BUILD_PANORAMA=OFF",
  "-DALICEVISION_BUILD_LIDAR=OFF",
  "-DALICEVISION_BUILD_DOC=OFF",
  "-DALICEVISION_BUILD_TESTS=OFF",
  "-DALICEVISION_BUILD_SWIG_BINDING=OFF",
  "-DALICEVISION_USE_CUDA=OFF",
  "-DALICEVISION_USE_SYCL=ON",
  "-DALICEVISION_USE_CCTAG=OFF",
  "-DALICEVISION_USE_APRILTAG=OFF",
  "-DALICEVISION_USE_POPSIFT=OFF",
  "-DALICEVISION_USE_ALEMBIC=ON",
  "-DALICEVISION_USE_UNCERTAINTYTE=OFF",
  "-DALICEVISION_USE_ONNX=OFF",
  "-DALICEVISION_USE_OPENCV=OFF",
  "-DALICEVISION_USE_OPENCV_CONTRIB=OFF",
  "-DALICEVISION_USE_USD=OFF",
  "-DALICEVISION_REQUIRE_CERES_WITH_ACCELERATESPARSE=OFF",
  "-DOpenMP_CXX_FLAGS=-fopenmp -I{homebrew}/opt/libomp/include",
  "-DOpenMP_C_FLAGS=-fopenmp -I{homebrew}/opt/libomp/include",
  "-DOpenMP_CXX_LIB_NAMES=omp",
  "-DOpenMP_C_LIB_NAMES=omp",
  "-DOpenMP_omp_LIBRARY={homebrew}/opt/libomp/lib/libomp.dylib",
  "-DCMAKE_CXX_COMPILER={llvm}/bin/clang++",
  "-DCMAKE_C_COMPILER={llvm}/bin/clang",
  "-DCMAKE_OSX_SYSROOT={sdk}",
  "-DCMAKE_CXX_SCAN_FOR_MODULES=OFF",
  "-DALICEVISION_DEPTHMAP_BACKEND=SYCL",
  "-DALICEVISION_USE_MESHSDFILTER=OFF",
  "-DAdaptiveCpp_DIR={adaptivecpp}/lib/cmake/AdaptiveCpp"
]
